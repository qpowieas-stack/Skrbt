-- نظام الانتقال الدقيق والمستهدف حسب الطلب
task.spawn(function()
    while true do
        if FarmActive then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    local targetPart = nil

                    for _, v in pairs(workspace:GetDescendants()) do
                        if v:IsA("BasePart") or v:IsA("MeshPart") then
                            local name = v.Name:lower()
                            local parentName = v.Parent and v.Parent.Name:lower() or ""
                            local fullName = name .. " " .. parentName

                            if not (fullName:find("checkpoint") or fullName:find("return") or fullName:find("back") or fullName:find("spawn")) then
                                if SelectedTarget == "Stage15" and (fullName:find("15") or fullName:find("stage15") or fullName:find("lvl15")) then
                                    targetPart = v
                                    break
                                elseif SelectedTarget == "World1" and (fullName:find("150k") or fullName:find("world1")) then
                                    targetPart = v
                                    break
                                elseif SelectedTarget == "World2" and (fullName:find("200m") or fullName:find("world2")) then
                                    targetPart = v
                                    break
                                elseif SelectedTarget == "World3" and (fullName:find("1t") or fullName:find("world3") or fullName:find("trillion")) then
                                    targetPart = v
                                    break
                                end
                            end
                        end
                    end

                    -- إذا لم يجد الاسم الحرفي، يتم اختيار الجزء المناسب حسب القائمة
                    if not targetPart then
                        local allParts = {}
                        for _, v in pairs(workspace:GetDescendants()) do
                            if v:IsA("BasePart") and (v.Name:lower():find("win") or v.Name:lower():find("end")) then
                                table.insert(allParts, v)
                            end
                        end
                        if #allParts > 0 then
                            table.sort(allParts, function(a, b) return a.Position.Magnitude > b.Position.Magnitude end)
                            if SelectedTarget == "Stage15" then
                                targetPart = allParts[math.min(15, #allParts)]
                            elseif SelectedTarget == "World1" then
                                targetPart = allParts[math.floor(#allParts * 0.7)]
                            elseif SelectedTarget == "World2" then
                                targetPart = allParts[math.floor(#allParts * 0.4)]
                            elseif SelectedTarget == "World3" then
                                targetPart = allParts[1]
                            end
                        end
                    end

                    if targetPart then
                        hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                        firetouchinterest(hrp, targetPart, 0)
                        firetouchinterest(hrp, targetPart, 1)
                    end
                end
            end)
        end
        task.wait(1)
    end
end)

