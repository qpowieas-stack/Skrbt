-- 3. عدم الموت المطور المباشر (Godmode Fix)
GodmodeBtn.MouseButton1Click:Connect(function()
    GodmodeEnabled = not GodmodeEnabled
    if GodmodeEnabled then
        GodmodeBtn.Text = "عدم الموت (Godmode): مفعل ✅"
        GodmodeBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
    else
        GodmodeBtn.Text = "عدم الموت (Godmode): معطل ❌"
        GodmodeBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)

RunService.Stepped:Connect(function()
    if GodmodeEnabled then
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.Health = hum.MaxHealth
                    hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                end

                -- إلغاء تأثير أجزاء القتل (Kill / Lava Parts)
                for _, part in pairs(char:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.Touched:Connect(function(hit)
                            if GodmodeEnabled and hit and (hit.Name:lower():find("kill") or hit.Name:lower():find("lava") or hit.Name:lower():find("death")) then
                                hum.Health = hum.MaxHealth
                            end
                        end)
                    end
                end
            end
        end)
    end
end)

