-- 1. خوارزمية التجميع الذكي بدون التفاعل مع بوابات العودة/الـ Checkpoints
AutoWinBtn.MouseButton1Click:Connect(function()
    AutoWinEnabled = not AutoWinEnabled
    if AutoWinEnabled then
        AutoWinBtn.Text = "تجميع أقصى فوز: مفعل ✅"
        AutoWinBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
    else
        AutoWinBtn.Text = "تجميع أقصى فوز: معطل ❌"
        AutoWinBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)

task.spawn(function()
    while true do
        if AutoWinEnabled then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart

                    local bestTarget = nil
                    local maxZ = -999999 -- الاعتماد على الاتجاه والعمق الأقصى للمرحلة النهائية

                    for _, v in pairs(workspace:GetDescendants()) do
                        if v:IsA("TouchTransmitter") or v.Name == "TouchInterest" then
                            local part = v.Parent
                            if part and part:IsA("BasePart") then
                                local name = part.Name:lower()
                                local parentName = part.Parent and part.Parent.Name:lower() or ""

                                -- استثناء بوابات العودة والـ Checkpoint والـ Restart
                                if not (name:find("spawn") or name:find("checkpoint") or name:find("return") or name:find("back") or parentName:find("spawn") or parentName:find("checkpoint")) then
                                    if name:find("win") or name:find("trophy") or name:find("end") or name:find("goal") or parentName:find("win") then
                                        -- فرز البوابات حسب العمق والمكان الأخير للماب
                                        local posVal = math.abs(part.Position.X) + math.abs(part.Position.Z)
                                        if posVal > maxZ then
                                            maxZ = posVal
                                            bestTarget = part
                                        end
                                    end
                                end
                            end
                        end
                    end

                    -- لمس هدف الفوز دون الانتقال الجسدي المباشر المفاجئ حتى لا تفعل بوابات السيرفر العكسية
                    if bestTarget then
                        firetouchinterest(hrp, bestTarget, 0)
                        firetouchinterest(hrp, bestTarget, 1)
                    end
                end
            end)
        end
        task.wait(0.2)
    end
end)

