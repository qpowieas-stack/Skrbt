task.spawn(function()
    while true do
        if FarmActive then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    local targetPart = nil
                    local validParts = {}

                    for _, v in pairs(workspace:GetDescendants()) do
                        if v:IsA("BasePart") or v:IsA("MeshPart") then
                            local name = v.Name:lower()
                            local parentName = v.Parent and v.Parent.Name:lower() or ""
                            
                            if not (name:find("checkpoint") or name:find("return") or name:find("back") or name:find("spawn")) then
                                if name:find("win") or name:find("end") or name:find("trophy") or name:find("finish") or parentName:find("win") then
                                    table.insert(validParts, v)
                                end
                            end
                        end
                    end

                    if #validParts > 0 then
                        table.sort(validParts, function(a, b)
                            return a.Position.Magnitude > b.Position.Magnitude
                        end)

                        if SelectedWorld == "World1" then
                            targetPart = validParts[math.floor(#validParts * 0.7)] or validParts[1]
                        elseif SelectedWorld == "World2" then
                            targetPart = validParts[math.floor(#validParts * 0.4)] or validParts[1]
                        elseif SelectedWorld == "World3" then
                            targetPart = validParts[1] -- أقصى النهاية
                        end
                    end

                    if targetPart then
                        hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                        firetouchinterest(hrp, targetPart, 0)
                        firetouchinterest(hrp, targetPart, 1)
                    end
                end
            end)
        end
        task.wait(1)
    end
end)

