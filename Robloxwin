-- 1. خوارزمية البحث واللمس لأكبر نقطة فوز (الـ Win الأخير فقط)
AutoWinBtn.MouseButton1Click:Connect(function()
    AutoWinEnabled = not AutoWinEnabled
    if AutoWinEnabled then
        AutoWinBtn.Text = "تجميع الكؤوس القصوى: مفعل ✅"
        AutoWinBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
    else
        AutoWinBtn.Text = "تجميع الكؤوس القصوى: معطل ❌"
        AutoWinBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)

task.spawn(function()
    while true do
        if AutoWinEnabled then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart

                    -- تجميع كل نقاط الفوز المتاحة مرتبة من الأبعد/الأعلى
                    local winParts = {}
                    for _, obj in pairs(workspace:GetDescendants()) do
                        if obj:IsA("TouchTransmitter") or obj.Name == "TouchInterest" then
                            local parent = obj.Parent
                            if parent and (parent.Name:lower():find("win") or parent.Name:lower():find("end") or parent.Name:lower():find("trophy") or parent.Name:lower():find("finish")) then
                                table.insert(winParts, parent)
                            end
                        end
                    end

                    -- تفاعل مع أطراف ونهايات المراحل (تحديداً الأخير في القائمة لتجاوز المراحل الأولى)
                    if #winParts > 0 then
                        for i = #winParts, 1, -1 do
                            local targetPart = winParts[i]
                            if targetPart and targetPart:IsA("BasePart") then
                                firetouchinterest(hrp, targetPart, 0)
                                firetouchinterest(hrp, targetPart, 1)
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.3)
    end
end)

-- 2. زر سرعة 300
Speed300Btn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChildOfClass("Humanoid") then
        char.Humanoid.WalkSpeed = 300
        Speed300Btn.Text = "تم تفعيل سرعة 300 🔥"
        task.wait(1.5)
        Speed300Btn.Text = "تفعيل سرعة 300 ⚡"
    end
end)

-- 3. عدم الموت
GodmodeBtn.MouseButton1Click:Connect(function()
    GodmodeEnabled = not GodmodeEnabled
    if GodmodeEnabled then
        GodmodeBtn.Text = "عدم الموت (Godmode): مفعل ✅"
        GodmodeBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
    else
        GodmodeBtn.Text = "عدم الموت (Godmode): معطل ❌"
        GodmodeBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)

RunService.Stepped:Connect(function()
    if GodmodeEnabled then
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.Health = hum.MaxHealth
                    hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                end
            end
        end)
    end
end)

