        AutoWinBtn.Text = "تجميع أقصى فوز: مفعل ✅"
        AutoWinBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
    else
        AutoWinBtn.Text = "تجميع أقصى فوز: معطل ❌"
        AutoWinBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)

task.spawn(function()
    while true do
        if AutoWinEnabled then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart

                    local bestWinPart = nil
                    local maxDistance = -1

                    for _, v in pairs(workspace:GetDescendants()) do
                        if v:IsA("BasePart") and (v.Name:lower():find("win") or v.Name:lower():find("finish") or v.Name:lower():find("end")) then
                            local dist = (v.Position - Vector3.new(0,0,0)).Magnitude
                            if dist > maxDistance then
                                maxDistance = dist
                                bestWinPart = v
                            end
                        end
                    end

                    if bestWinPart then
                        hrp.CFrame = bestWinPart.CFrame + Vector3.new(0, 3, 0)
                        firetouchinterest(hrp, bestWinPart, 0)
                        firetouchinterest(hrp, bestWinPart, 1)
                    end
                end
            end)
        end
        task.wait(0.2)
    end
end)

